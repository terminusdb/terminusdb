{
  "name": "terminusdb-tests",
  "version": "0.0.1",
  "private": true,
  "description": "TerminusDB Integration Tests and Benchmarks",
  "homepage": "https://github.com/terminusdb/terminusdb/tree/main/tests",
  "bugs": {
    "url": "https://github.com/terminusdb/terminusdb/issues"
  },
  "license": "Apache-2.0",
  "author": "Sean Leather <sean@terminusdb.com>",
  "scripts": {
    "bench": "node bench.js",
    "check": "eslint .",
    "lint": "eslint . --fix",
    "start-server": "http-server ./served -c-1 --port 7474",
    "test": "npm run check && npm run test-local && npm run test-served",
    "test-local": "rc=0; mocha test --exclude test/data-version.js --exclude 'test/cli-*.js' || rc=1; MOCHA_PARALLEL=true mocha 'test/cli-*.js' || rc=1; mocha test/data-version.js || rc=1; exit $rc",
    "test-served": "start-server-and-test start-server http://127.0.0.1:7474/ 'mocha test-served'"
  },
  "dependencies": {
    "@apollo/client": "^3.7.1",
    "buffalo-bench": "^2.0.0",
    "chai": "^4.3.6",
    "cross-fetch": "^3.1.5",
    "decimal.js": "^10.6.0",
    "fast-glob": "^3.2.11",
    "jsonwebtoken": "^9.0.0",
    "mocha": "^12.0.3",
    "optionator": "^0.9.1",
    "stream-json": "^3.7.0",
    "superagent": "^7.1.1"
  },
  "devDependencies": {
    "@eslint/json": "^2.1.1",
    "eslint": "^10.14.0",
    "eslint-plugin-mocha": "^12.0.2",
    "http-server": "^14.1.0",
    "neostandard": "^0.14.1",
    "start-server-and-test": "^2.0.3"
  },
  "overrides": {
    "serialize-javascript": "^7.1.4",
    "minimatch": "^11.0.2",
    "glob": "^14.0.3"
  }
}
