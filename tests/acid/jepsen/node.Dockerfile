# Jepsen DB node: the server under test plus sshd. Jepsen manages
# `terminusdb serve` itself over SSH — the entrypoint only runs sshd.
ARG TERMINUSDB_IMAGE=terminusdb/terminusdb-server:local
FROM ${TERMINUSDB_IMAGE}
USER root

RUN apt-get update \
 && apt-get install -y --no-install-recommends openssh-server procps sudo \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /run/sshd /root/.ssh /opt/tdb

# Throwaway keypair generated by `make test-acid-jepsen` into
# tests/acid/jepsen/secret/ (gitignored; regenerate with `make` if missing).
COPY secret/id_rsa.pub /root/.ssh/authorized_keys
RUN chmod 700 /root/.ssh && chmod 600 /root/.ssh/authorized_keys

COPY setup-db.py /opt/tdb/setup-db.py

EXPOSE 22 6363
CMD ["/usr/sbin/sshd", "-D", "-e"]
