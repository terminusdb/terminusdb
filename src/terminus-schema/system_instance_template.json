{ "@id" : "Organization/admin",
  "@type" : "Organization",
  "name" : "admin",
  "database" : [ "SystemDatabase/system" ] }

{ "@id" : "Role/admin",
  "@type" : "Role",
  "name" : "Admin Role",
  "action" : [ "create_database",
               "delete_database",
               "class_frame",
               "clone",
               "fetch",
               "push",
               "branch",
               "rebase",
               "instance_read_access",
               "instance_write_access",
               "schema_read_access",
               "schema_write_access",
               "meta_read_access",
               "meta_write_access",
               "commit_read_access",
               "commit_write_access",
               "manage_capabilities",
               "search",
               "search_snippets",
               "reindex_write",
               "woql_main_exec",
               "woql_logic_exec",
               "woql_logic_read",
               "woql_logic_write",
               "woql_other_exec",
               "woql_search",
               "woql_instance_read",
               "woql_instance_write",
               "woql_schema_read",
               "woql_schema_write"
             ]}

{ "@id" : "Capability/server_access",
  "@type" : "Capability",
  "scope" : "Organization/admin",
  "role" : "Role/admin" }

{ "@id" : "User/anonymous",
  "@type" : "User",
  "name" : "anonymous",
  "capability" : [] }

{ "@id" : "Role/consumer",
  "@type" : "Role",
  "name" : "Consumer Role",
  "action" : [ "class_frame",
               "clone",
               "fetch",
               "meta_read_access",
               "commit_read_access",
               "instance_read_access",
               "schema_read_access",
               "search",
               "search_snippets"
             ]}

{ "@id" : "Role/executor",
  "@type" : "Role",
  "name" : "Executor Role",
  "action" : [ "search",
               "woql_logic_exec"
             ]}

{ "@id" : "User/admin",
  "@type" : "User",
  "name" : "admin",
  "key_hash" : "~s",
  "capability" : [ "Capability/server_access" ] }

{ "@id" : "SystemDatabase/system",
  "@type" : "SystemDatabase",
  "name" : "_system"}
