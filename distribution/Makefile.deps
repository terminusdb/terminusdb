TUS_VERSION := v0.0.17

SWIPL = LANG=C.UTF-8 $(SWIPL_DIR)swipl

################################################################################

.PHONY: default
default:
	@$(MAKE) install-tus

.PHONY: install-tus
install-tus: REPO_URL=https://github.com/terminusdb-org/tus.git
install-tus: PACK_NAME=tus
install-tus: BRANCH=$(TUS_VERSION)
install-tus: install-pack

.PHONY: install-pack
install-pack:
	mkdir -p .deps/$(PACK_NAME)
	if [ -d .deps/$(PACK_NAME)/.git ]; then git -C .deps/$(PACK_NAME) pull --quiet; else git clone --depth 1 --branch $(BRANCH) $(REPO_URL) .deps/$(PACK_NAME); fi
	$(SWIPL) \
	  --on-error=halt \
	  -g "ensure_loaded(library(filesex))" \
	  -g "( absolute_file_name(pack('.'), PackHome, [file_type(directory), access(write), file_errors(fail)]) -> true ; absolute_file_name(user_app_data(pack), PackHome, [file_errors(fail)]), make_directory_path(PackHome) ), directory_file_path(PackHome, $(PACK_NAME), Target), ( read_link(Target, _, _) -> delete_file(Target) ; exists_directory(Target) -> delete_directory_and_contents(Target) ; true ), link_file('$(CURDIR)/.deps/$(PACK_NAME)', Target, symbolic), writeln(pack_linked($(PACK_NAME), Target))" \
	  -g "attach_packs('$(CURDIR)/.deps', [duplicate(replace)])" \
	  -g "(use_module(library($(PACK_NAME))) -> writeln(pack_ok($(PACK_NAME))) ; halt(1))" \
	  -g halt

.PHONY: clean
clean: clean-deps

.PHONY: clean-deps
clean-deps:
	rm -rf .deps
