TUS_VERSION := v0.0.17

SWIPL = LANG=C.UTF-8 $(SWIPL_DIR)swipl

PACK_INSTALL_OPTIONS := [interactive(false)]

################################################################################

.PHONY: default
default:
	@$(MAKE) install-tus

.PHONY: install-tus
install-tus: REPO_URL=https://github.com/terminusdb-org/tus.git
install-tus: PACK_NAME=tus
install-tus: BRANCH=$(TUS_VERSION)
install-tus: install-pack

.PHONY: install-pack
install-pack:
	mkdir -p .deps/$(PACK_NAME)
	git clone --depth 1 --branch $(BRANCH) $(REPO_URL) .deps/$(PACK_NAME) 2> /dev/null || git -C .deps/$(PACK_NAME) pull --quiet
	$(SWIPL) \
	  --on-error=halt \
	  -g "ignore(catch(pack_remove($(PACK_NAME)), _, fail))" \
	  -g "ignore(catch(pack_install('file://$(CURDIR)/.deps/$(PACK_NAME)', $(PACK_INSTALL_OPTIONS)), _, fail))" \
	  -g "pack_attach('$(CURDIR)/.deps/$(PACK_NAME)', [])" \
	  -g "(use_module(library($(PACK_NAME))) -> writeln(pack_ok($(PACK_NAME))) ; halt(1))" \
	  -g halt

.PHONY: clean
clean: clean-deps

.PHONY: clean-deps
clean-deps:
	rm -rf .deps
